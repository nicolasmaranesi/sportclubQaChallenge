
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --include=dev --no-audit --no-fund

COPY . .

# Permitir que el usuario no privilegiado ejecute Vitest
# y escriba los archivos de caché.
RUN mkdir -p /app/reports \
    && chown -R node:node /app

USER node

CMD ["./node_modules/.bin/vitest", "run", "tests/checkout.unit.test.ts", "--reporter=default", "--reporter=junit", "--outputFile.junit=/app/reports/unit-results.xml"]
